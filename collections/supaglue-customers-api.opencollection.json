{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unified CRM Accounts Customers API",
    "version": "0.25.7"
  },
  "items": [
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.supaglue.io/crm/v2/customers",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Get a list of customers"
        },
        {
          "info": {
            "name": "Upsert customer",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.supaglue.io/crm/v2/customers",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Upsert customer"
        },
        {
          "info": {
            "name": "Get customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.supaglue.io/crm/v2/customers/:customer_id",
            "params": [
              {
                "name": "customer_id",
                "value": "your-customers-unique-application-id",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Get customer"
        },
        {
          "info": {
            "name": "Delete customer",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.supaglue.io/crm/v2/customers/:customer_id",
            "params": [
              {
                "name": "customer_id",
                "value": "your-customers-unique-application-id",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Delete customer"
        }
      ]
    }
  ],
  "bundled": true
}