{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unified Enrichment API",
    "version": "0.14.0"
  },
  "items": [
    {
      "info": {
        "name": "Forms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit form",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.supaglue.io/marketing-automation/v2/forms/:form_id/_submit",
            "headers": [
              {
                "name": "x-customer-id",
                "value": "my-customer-1"
              },
              {
                "name": "x-provider-name",
                "value": "salesforce"
              }
            ],
            "params": [
              {
                "name": "form_id",
                "value": "12345",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Submit form"
        },
        {
          "info": {
            "name": "List forms",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.supaglue.io/marketing-automation/v2/forms",
            "headers": [
              {
                "name": "x-customer-id",
                "value": "my-customer-1"
              },
              {
                "name": "x-provider-name",
                "value": "salesforce"
              }
            ],
            "params": [
              {
                "name": "include_raw_data",
                "value": "true",
                "type": "query",
                "description": "Whether to include raw data fetched from the 3rd party provider."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "List forms"
        },
        {
          "info": {
            "name": "Get form fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.supaglue.io/marketing-automation/v2/forms/:form_id/_fields",
            "headers": [
              {
                "name": "x-customer-id",
                "value": "my-customer-1"
              },
              {
                "name": "x-provider-name",
                "value": "salesforce"
              }
            ],
            "params": [
              {
                "name": "include_raw_data",
                "value": "true",
                "type": "query",
                "description": "Whether to include raw data fetched from the 3rd party provider."
              },
              {
                "name": "form_id",
                "value": "12345",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Get form fields"
        }
      ]
    }
  ],
  "bundled": true
}