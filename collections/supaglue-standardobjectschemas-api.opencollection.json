{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unified CRM Accounts StandardObjectSchemas API",
    "version": "0.25.7"
  },
  "items": [
    {
      "info": {
        "name": "StandardObjectSchemas",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List standard object schemas",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.supaglue.io/crm/v2/metadata/standard_objects",
            "headers": [
              {
                "name": "x-customer-id",
                "value": "my-customer-1"
              },
              {
                "name": "x-provider-name",
                "value": "salesforce"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "List standard object schemas\n\nSupport:\n\n| Provider    | Supported |\n| ----------- | --------- |\n| Hubspot     | Yes       |\n| Salesforce  | Yes       |\n| Pipedrive   | No        |\n| MS Dynamics | No        |\n"
        }
      ]
    }
  ],
  "bundled": true
}