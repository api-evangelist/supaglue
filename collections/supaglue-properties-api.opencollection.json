        },
        {
          "info": {
            "name": "Register Property (preview)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.supaglue.io/crm/v2/metadata/properties/:object_name/register",
            "headers": [
              {
                "name": "x-customer-id",
                "value": "my-customer-1"
              },
              {
                "name": "x-provider-name",
                "value": "salesforce"
              }
            ],
            "params": [
              {
                "name": "object_name",
                "value": "contact",
                "type": "path"
              }
