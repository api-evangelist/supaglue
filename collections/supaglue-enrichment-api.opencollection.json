{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unified Enrichment API",
    "version": "0.25.7"
  },
  "items": [
    {
      "info": {
        "name": "Persons",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Enrich person",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.supaglue.io/enrichment/v2/persons",
            "headers": [
              {
                "name": "x-customer-id",
                "value": "my-customer-1"
              },
              {
                "name": "x-provider-name",
                "value": "salesforce"
              }
            ],
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Enrich person"
        }
      ]
    }
  ],
  "bundled": true
}